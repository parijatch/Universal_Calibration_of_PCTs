# The exact deterministic constant for AGG(2,1)
# A_n(v) = (1 + sqrt(0.8)) / ||v||_2.
# Since v will be a Euclidean unit vector, ||v||_2 = 1.
A_n <- 1 + ((log(pi)+1.2*log(log(n)))/log(n))^(1/nu)
